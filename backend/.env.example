# Copy to backend/.env and fill in. Never commit .env.

# Required
DJANGO_SECRET_KEY=change-me
HERE_API_KEY=

# Local development
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: Open-Meteo paid tier (dedicated limit instead of the shared per-IP one)
# OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com
# OPEN_METEO_API_KEY=
